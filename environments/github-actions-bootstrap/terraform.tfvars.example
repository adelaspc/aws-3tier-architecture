# Replace these values before running Terraform.
project     = "aws-3tier"
environment = "dev"
region      = "us-east-1"

# Repository and GitHub Environment names must match the workflow configuration.
github_repository      = "username/aws-3tier-architecture"
github_environment     = "terraform-dev"
github_app_environment = "app-dev"

# This ECR repository is a prerequisite and is not created by this Terraform stack.
ecr_repository_name = "deployments-notes-app"

# Must match the backend bootstrap output.
state_bucket_name = "aws-3tier-dev-terraform-state-example"
dev_state_key     = "aws-3tier-architecture/dev/terraform.tfstate"

# Optional override. Must start with / when set.
deployment_app_ssm_prefix = "/dev/deployment-app"
